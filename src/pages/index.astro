---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import banner from "../assets/PinoleroBanner.webp";
import nosotros from "../assets/nosotros.webp";

import camisetas from "../assets/Camisetas.webp";
import totebags from "../assets/ToteBags.webp";
import camisablanca from "../assets/CamisaBlanca.webp";
import mugs from "../assets/mugs.webp";

import facebook from "../assets/icons/facebook.svg";
import instagram from "../assets/icons/instagram.svg";
import tiktok from "../assets/icons/tiktok.svg";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    {/* HEADER */}
    <header class="header">
        <div class="container header-content">
            <Image
                src={banner}
                alt="Banner principal de PinoleroPrints"
                class="banner"
                loading="eager"
            />
            <button class="menu-btn"> ☰ </button>

            <nav class="nav">
                <a href="#inicio"> Inicio </a>
                <a href="#servicios"> Servicios </a>
                <a href="#catalogo"> Catálogo </a>
                <a href="#nosotros"> Nosotros </a>
            </nav>

            <a
                href="https://wa.me/50588207075"
                target="_blank"
                class="btn-primary"
            >
                WhatsApp
            </a>
        </div>
    </header>

    {/* HERO */}
    <section id="inicio" class="hero">
        <div class="container hero-grid">
            <div>
                <span class="badge">Personalización • Diseño • Producción</span>

                <h1 class="hero-title">
                    Tu idea.
                    <span>Nuestra impresión.</span>
                </h1>

                <p class="hero-text">
                    Creamos productos personalizados con acabados premium en
                    sublimación, DTF, bordado y grabado láser.
                </p>

                <div class="hero-buttons">
                    <a
                        href="https://wa.me/50588207075"
                        target="_blank"
                        class="btn-primary big"
                    >
                        Cotizar por WhatsApp
                    </a>

                    <a href="#catalogo" class="btn-secondary big">
                        Ver catálogo
                    </a>
                </div>
            </div>

            <Image
                src={camisablanca}
                alt="Imagen de una persona modelando una camisa en blanco"
                class="hero-image"
                loading="eager"
            />
        </div>
    </section>

    {/* SERVICIOS */}
    <section id="servicios" class="section container">
        <div class="section-header">
            <h2>Nuestros Servicios</h2>
            <p>Soluciones profesionales para personalización y branding.</p>
        </div>

        <div class="cards-grid">
            {
                [
                    {
                        nombre: "Sublimación",
                        descripcion:
                            "Personalización de tazas, camisetas y artículos promocionales con acabados duraderos.",
                    },
                    {
                        nombre: "Impresión DTF",
                        descripcion:
                            "Impresión textil de alta calidad para prendas con colores vibrantes y resistentes.",
                    },
                    {
                        nombre: "Bordado",
                        descripcion:
                            "Bordados profesionales para uniformes, gorras y prendas corporativas.",
                    },
                    {
                        nombre: "Grabado Láser",
                        descripcion:
                            "Grabados precisos y personalizados en madera, acrílico, metal y otros materiales.",
                    },
                    {
                        nombre: "Diseño Gráfico",
                        descripcion:
                            "Diseños creativos para marcas, publicidad y material promocional.",
                    },
                    {
                        nombre: "Personalización Empresarial",
                        descripcion:
                            "Soluciones personalizadas para fortalecer la identidad visual de tu empresa.",
                    },
                ].map((servicio) => (
                    <div class="card">
                        <h3>{servicio.nombre}</h3>
                        <p>{servicio.descripcion}</p>
                    </div>
                ))
            }
        </div>
    </section>

    {/* CATALOGO */}
    <section id="catalogo" class="catalogo">
        <div class="container">
            <div class="section-header">
                <h2>Catálogo</h2>
                <p>Productos personalizados disponibles.</p>
            </div>

            <div class="cards-grid">
                {
                    [
                        {
                            nombre: "Camisetas",
                            imagen: camisetas,
                            alt: "Mujer Modelado camiseta negra con una imagen de una mano de esqueleto",
                        },
                        {
                            nombre: "Tote Bags",
                            imagen: totebags,
                            alt: "hombre posando extendiendo la mano con una Tote Bags de color negro y mostaza",
                        },
                        {
                            nombre: "Mugs",
                            imagen: mugs,
                            alt: "Mug, tazon de ceramica con la imagen de el guarda barranco",
                        },
                    ].map((producto) => (
                        <div class="product-card">
                            <Image
                                src={producto.imagen}
                                loading="lazy"
                                alt={producto.alt}
                            />

                            <div class="product-content">
                                <span>{producto.nombre}</span>

                                <a
                                    href="https://wa.me/50588207075"
                                    target="_blank"
                                    class="btn-primary"
                                >
                                    Comprar
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    {/* NOSOTROS */}
    <section id="nosotros" class="section container">
        <div class="about-grid">
            <div>
                <h2 class="about-title">Sobre Pinolero Prints</h2>

                <p class="about-text">
                    Somos una marca enfocada en personalización profesional,
                    diseño moderno y producción de calidad.
                </p>

                <p class="about-text">
                    Trabajamos con clientes individuales, negocios y marcas que
                    buscan destacar con productos personalizados premium.
                </p>
            </div>

            <Image src={nosotros} alt="Pinolero Prints" class="about-image" />
        </div>
    </section>

    {/* FOOTER */}
    <footer class="footer">
        <div class="container footer-content">
            <div>
                <h3 class="footer-title">PINOLERO PRINTS</h3>
                <p class="footer-p">Diseño • Personalización • Producción</p>
            </div>

            <a
                href="https://wa.me/50557764961"
                target="_blank"
                rel="noopener noreferrer"
                class="copyright"
            >
                <p>
                    © 2026 PinoleroPrints · Sitio desarrollado en colaboración
                    con RK8`
                </p>
            </a>

            <ul class="footer-links">
                {
                    [
                        {
                            nombre: "Instagram",
                            imagen: instagram,
                            alt: "Icono de Instagram",
                            url: "https://www.instagram.com/pinoleroprints?igsh=eWVpdWpoZWFpbmhs",
                        },
                        {
                            nombre: "TikTok",
                            imagen: tiktok,
                            alt: "Icono de Tiktok",
                            url: "https://www.tiktok.com/@pinolero.prints?_r=1&_t=ZS-96E0c3ZmL3s",
                        },
                        {
                            nombre: "Facebook",
                            imagen: facebook,
                            alt: "Icono de facebook",
                            url: "https://www.facebook.com/share/1H3nidLACr/",
                        },
                    ].map((enlace) => (
                        <li>
                            <a
                                class="link"
                                href={enlace.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={enlace.nombre}
                            >
                                <Image
                                    class="icon"
                                    src={enlace.imagen}
                                    alt=""
                                    aria-hidden="true"
                                />
                                <span>{enlace.nombre}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </footer>
</Layout>
