---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroSection from "@/components/HeroSection.astro";
import ServicesSection from "@/components/ServicesSection.astro";
import CatalogSection from "@/components/CatalogSection.astro";
import AboutSection from "@/components/AboutSection.astro";
import Footer from "@/components/Footer.astro";

import { URLS, NAV_LINKS, SERVICES, PRODUCTS } from "@/constants";
import { camisetas, totebags, mugs } from "@/assets";
---

<Layout>
    <Header navLinks={NAV_LINKS} whatsappUrl={URLS.whatsapp} />
    <HeroSection whatsappUrl={URLS.whatsapp} />
    <ServicesSection services={SERVICES} />
    <CatalogSection
        products={PRODUCTS}
        productImages={[camisetas, totebags, mugs]}
        whatsappUrl={URLS.whatsapp}
    />
    <AboutSection />
    <Footer />
</Layout>
