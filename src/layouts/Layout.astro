---
import "@/styles/global.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="Content-Language" content="es" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#0d0d0d" />
        <meta
            name="description"
            content="PinoleroPrints ofrece diseños personalizados, sublimación y productos creativos en Nicaragua."
        />
        <link rel="canonical" href="https://pinoleroprints.rk8.dev/" />

        <!-- Open Graph -->
        <meta
            property="og:title"
            content="PinoleroPrints | Diseños y Sublimación en Nicaragua"
        />
        <meta
            property="og:description"
            content="Diseños personalizados, sublimación y productos creativos."
        />
        <meta property="og:url" content="https://pinoleroprints.rk8.dev/" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="PinoleroPrints" />
        <meta property="og:locale" content="es_NI" />
        <meta
            property="og:image"
            content="https://pinoleroprints.rk8.dev/og-image.jpg"
        />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="PinoleroPrints - De tu cabeza a tus manos. Ropa, tazas, stickers y más."
        />

        <!-- Twitter/X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="PinoleroPrints | Diseños y Sublimación en Nicaragua"
        />
        <meta
            name="twitter:description"
            content="Diseños personalizados, sublimación y productos creativos."
        />
        <meta
            name="twitter:image"
            content="https://pinoleroprints.rk8.dev/og-image.jpg"
        />
        <meta
            name="twitter:image:alt"
            content="PinoleroPrints - De tu cabeza a tus manos. Ropa, tazas, stickers y más."
        />

        <title>PinoleroPrints | Diseños y Sublimación en Nicaragua</title>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                "name": "PinoleroPrints",
                "description": "Diseños personalizados, sublimación y productos creativos en Nicaragua.",
                "url": "https://pinoleroprints.rk8.dev",
                "sameAs": [
                    "https://www.facebook.com/share/1H3nidLACr/",
                    "https://www.instagram.com/pinoleroprints",
                    "https://www.tiktok.com/@pinolero.prints"
                ],
                "telephone": "+50588207075",
                "priceRange": "$$",
                "address": {
                    "@type": "PostalAddress",
                    "addressCountry": "NI"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "addressCountry": "NI"
                }
            }
        </script>
    </head>
    <body>
        <slot />
        <!-- Cloudflare Web Analytics -->
        <script
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "45f4a7ee4b5e404d877a99e4ea86436a"}'
        ></script><!-- End Cloudflare Web Analytics -->
    </body>
</html>
<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
